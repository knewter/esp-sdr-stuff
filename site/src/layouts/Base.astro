---
import "../styles/global.css";
import "../styles/sdr.css";
import { specs, url } from "../lib/specs";
interface Props { title: string; description?: string; source?: "specs" | "hand" | "work" }
const { title, description = "Evaluate an original ESP32 as an SDR alongside an RTL-SDR Blog V4 and FPGA options.", source = "hand" } = Astro.props;
const links = [["", "Overview"], ["work/", "Experiments"], ["compare/", "RTL-SDR comparison"], ["fpga/", "FPGA routes"], ["evidence/", "Evidence"], ["sources/", "Sources"]];
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} · ESP32 SDR Lab</title><meta name="description" content={description} />
  <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@500;600;700&display=swap" rel="stylesheet" />
  <script is:inline src={url("theme-init.js")}></script>
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="site-header"><a class="brand" href={url("")} aria-label="ESP32 SDR Lab home"><span class="brand-mark" aria-hidden="true">∿</span><span>ESP32 <b>SDR LAB</b></span></a><nav aria-label="Main navigation">{links.map(([path,label]) => <a href={url(path)} aria-current={Astro.url.pathname === url(path) ? "page" : undefined}>{label}</a>)}</nav><button id="theme-toggle" class="theme-button" type="button" aria-label="Switch between light and dark">◐</button></header>
  <div id="content" class="page-shell"><slot /></div>
  <footer class="lab-footer"><div><a class="brand" href={url("")}>ESP32 <b>SDR LAB</b></a><p>One board. Two receivers. Evidence before assumptions.</p></div><div><p>Snapshot {specs.generated} · <a href={url("revision.json")}><code>{specs.sourceRevision.slice(0,12)}</code></a></p><p><a href={url("ledger/")}>Accepted ledger</a> · <a href="https://github.com/knewter/esp-sdr-stuff">GitHub</a> · <a href="https://openspec.dev">OpenSpec</a></p><p class="dim">{source === "work" ? "Committed task status; hardware proof is separate." : source === "specs" ? "Accepted requirements rendered from the repository." : "Results, upstream reports and plans are distinct."}</p></div></footer>
  <script>document.querySelector("#theme-toggle")?.addEventListener("click",()=>{const root=document.documentElement;root.dataset.theme=root.dataset.theme === "dark" ? "light" : "dark";try{localStorage.setItem("sdr-theme",root.dataset.theme)}catch{}});</script>
</body>
</html>
