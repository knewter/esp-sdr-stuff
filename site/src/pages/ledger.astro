---
import Base from "../layouts/Base.astro";
import Tape from "../components/Tape.astro";
import { specs, url } from "../lib/specs";
---
<Base title="Accepted requirement ledger" source="specs"><header class="page-title"><p class="eyebrow">ACCEPTED LEDGER / SCOPED PROOF</p><h1>{specs.tally.grounded} grounded requirements.<br />Evidence defines their scope.</h1><p class="lede">{specs.tally.unverified} unverified of {specs.total} accepted requirements. Read each requirement’s grounding and scenarios. Acceptance of capture transport does not establish calibrated RF reception or an application decoder; unfinished experiments remain separate drafts.</p><Tape tally={specs.tally} /></header><div class="card-grid">{specs.capabilities.map((cap) => <article class="research-card"><p class="eyebrow">{cap.group}</p><h3>{cap.name}</h3><p>{cap.purposeFirst}</p><a href={url(`c/${cap.slug}/`)}>Inspect requirements →</a></article>)}</div></Base>
