---
import Base from "../../layouts/Base.astro";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { specs, url, kib, resolveBase } from "../../lib/specs";
import { evidenceMarkdownLinks, rawEvidenceUrl, relativeEvidenceUrl } from "../../lib/evidence-markdown";

export function getStaticPaths() {
  return specs.evidence.map((file) => ({
    params: { slug: file.slug },
    props: { file },
  }));
}

const { file } = Astro.props;
const pagePath = url(`evidence/${file.slug}/`);
const localUrl = (value: string) => relativeEvidenceUrl(value, pagePath);
const markdown = file.kind === "text" && file.text !== undefined && file.path.toLowerCase().endsWith(".md")
  ? (await (await createMarkdownProcessor({
      syntaxHighlight: false,
      remarkRehype: { allowDangerousHtml: false },
      rehypePlugins: [evidenceMarkdownLinks(file.path, specs.evidence, import.meta.env.BASE_URL, specs.sourceRevision, pagePath)],
    })).render(file.text ?? "")).code
  : null;
---

<Base title={`${file.name} — evidence`} description="SDR experiment evidence.">
  <nav class="crumbs">
    <a href={localUrl(url(""))}>&larr; all capabilities</a>
    <span class="mono dim">{file.path}</span>
  </nav>

  <header class="cap-head">
    <p class="eyebrow">evidence &middot; {kib(file.bytes)}</p>
    <h1>{file.name}</h1>
    {file.kind === "text" && <p class="ev-source"><a href={localUrl(rawEvidenceUrl(specs.sourceRevision, file.path))}>Open raw source</a></p>}
  </header>

  {
    file.kind === "image" ? (
      <div class="ev-image">
        <img src={file.asset ? url(file.asset) : resolveBase(file.mediaUrl ?? "")} alt={file.path} />
      </div>
    ) : file.kind === "video" ? (
      <section class="ev-media">
        <p>
          This recording is exported from the same immutable source revision as the work board.
          Its origin and measurement limitations are recorded alongside it.
        </p>
        <a class="media-link" href={resolveBase(file.mediaUrl ?? "")}>Open the source video</a>
      </section>
    ) : file.kind === "text" && file.text === undefined ? (
      <p class="ev-media"><a href={resolveBase(file.mediaUrl ?? "")}>Open the complete evidence file at this revision</a></p>
    ) : markdown !== null ? (
      <article class="ev-markdown" set:html={markdown} />
    ) : (
      <pre class="ev-text">{file.text}</pre>
    )
  }
</Base>
