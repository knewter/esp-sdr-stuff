---
import Base from "../../layouts/Base.astro";
import { specs, url, evidenceUrl, evidenceAsset } from "../../lib/specs";
const milestones = [
  {path:"docs/evidence/firmware-preservation/README.md",title:"Two matching full-flash reads",kind:"Physical flash read",limit:"4 MiB preserved privately; identical size/hash from independent reads."},
  {path:"docs/evidence/first-restoration/README.md",title:"Original bytes restored after SDR trial",kind:"Physical write / readback / reset",limit:"Full readback matches and original app resets. Actual power-cycle proof remains open."},
  {path:"docs/evidence/sdr-installation/README.md",title:"Upstream image booted; UART mismatch",kind:"Physical startup / failed protocol",limit:"2 Mbaud request clamped to 1 Mbaud by this bridge. No accepted RF samples."},
  {path:"docs/evidence/sdr-installation-uart1m/README.md",title:"1 Mbaud variant booted without replies",kind:"Physical startup / failed protocol",limit:"No acknowledgement; failed communication alone does not identify an ADC/RF fault."},
  {path:"docs/evidence/sdr-diagnostic-trial/README.md",title:"Diagnostic command loop works at 115,200",kind:"Physical startup / protocol replies",limit:"Initialization completes and five commands answer. Instrumented image is not the RF baseline."},
  {path:"docs/evidence/sdr-installation-uart921600/README.md",title:"Clean 921,600-baud command loop",kind:"Physical installation / protocol replies",limit:"Complete query replies identify the clean baseline. Accepted tuning range is not validated RF coverage."},
  {path:"docs/evidence/snapshot-baseline/README.md",title:"600/600 snapshot CRC and count passes",kind:"Physical capture transport / measured timing",limit:"Six 100-capture series; nominal windows versus measured wall time. Known-signal RF response remains unverified."},
  {path:"docs/evidence/spectrum-baseline/README.md",title:"60-second hardware spectrum session completed",kind:"Physical spectrum acquisition / browser display",limit:"7,205 CRC-checked 512-bin frames, matching totals and explicit gaps. Uncalibrated codes; no source identity."},
  {path:"docs/evidence/spectrum-baseline-1024-failed/README.md",title:"First browser stream stopped on CRC failure",kind:"Physical spectrum session / failed integrity gate",limit:"1,024-bin session stopped after 40.88 seconds and 2,711 valid frames; it did not complete the 60-second gate."},
  {path:"docs/evidence/rtl-continuity/README.md",title:"Four measured RTL USB transport trials",kind:"Physical internal-pattern transport",limit:"Each exceeds 65 seconds; one ≥80-byte gap at 2.048 MS/s. Lower-bound loss checker."},
  {path:"docs/evidence/rtl-fm-survey/README.md",title:"Measured ambient FM candidate",kind:"Physical RF capture / derived plots",limit:"19 kHz structure reproduced. Antenna, station, decoder and RF-mode continuity remain unverified."},
  {path:"docs/evidence/fpga-inventory/README.md",title:"FPGA source review and capacity budgets",kind:"Read-only enumeration / calculations",limit:"Pinned schematic, memories, clock/grade conflicts and throughput bounds. No FPGA transport benchmark."},
  {path:"docs/research/measured-recommendations.md",title:"Application choices from measured transport",kind:"Measured recommendations / sourced coverage",limit:"Combines RTL delivery, ESP gaps and FPGA budgets. Known-source applications and sensitivity comparisons remain open."},
  {path:"docs/evidence/independent-review/README.md",title:"Independent acceptance and integrity review",kind:"Review / recomputation",limit:"Checks preservation, parsers, manifests and RTL-derived results. Full goal acceptance remains open."}
];
const records = specs.evidence.filter(file => file.path.endsWith("README.md") || file.path.endsWith("source-index.md"));
function classification(path:string){
  const selected=milestones.find(item=>item.path===path);if(selected)return selected.kind;
  if(path.startsWith("docs/design/"))return "Design illustration / not measured";
  if(path.includes("site-preview"))return "Host capture / site verification";
  if(path.includes("identification")||path.includes("preservation-baseline"))return "Physical identity / historical boot";
  if(path.includes("firmware-artifact")||path.includes("firmware-uart")||path.includes("firmware-diagnostic"))return "Host build / artifact validation";
  if(path.includes("ble-source-registration"))return "Host BLE control / no exact air counts";
  return "Research / workflow record";
}
---
<Base title="Evidence library">
<header class="page-title"><p class="eyebrow">RECORDS / PROVENANCE MATTERS</p><h1>Real trials.<br />Visible limits.</h1><p class="lede">Physical reads, writes, command replies and RTL measurements are on file. 600 ESP snapshots pass CRC/count checks; the 512-bin browser session completes 60 seconds. Controlled RF response, known-source applications and FPGA transport remain open. Host screenshots prove the site; design illustrations explain plans.</p><a href={evidenceUrl("docs/evidence/workflow-origin/README.md")}>Tracking workflow origin →</a></header>
<section class="section"><div class="section-head"><div><p class="eyebrow">LATEST HARDWARE CHECKPOINTS</p><h2>Inspect the claim and its proof.</h2></div><p>These records retain settings, firmware revisions, logs, hashes and missing gates. A failed trial is evidence too.</p></div><div class="record-list">{milestones.map(item=><article class="record"><p class="eyebrow">{item.kind}</p><h2>{item.title}</h2><p>{item.limit}</p><a href={evidenceUrl(item.path)}>Inspect the evidence ↗</a></article>)}</div></section>
<section class="section"><div class="section-head"><div><p class="eyebrow">MEASURED VISUALS / NO ESP RF CLAIM</p><h2>Plots from actual receiver artifacts.</h2></div><p>The source logs and analysis records travel with each image.</p></div><div class="split"><a class="measurement-preview" href={evidenceUrl("docs/evidence/spectrum-baseline/README.md")}><img src={evidenceAsset("docs/evidence/spectrum-baseline/live-browser.png")} alt="Actual live ESP spectrum browser with explicit gaps and uncalibrated power codes" loading="lazy"/><span>Physical ESP spectrum session · no known-source RF claim ↗</span></a><a class="measurement-preview" href={evidenceUrl("docs/evidence/snapshot-baseline/README.md")}><img src={evidenceAsset("docs/evidence/snapshot-baseline/snapshot-timing.svg")} alt="Measured ESP snapshot delivery timing and calculated nominal coverage" loading="lazy"/><span>600 CRC/count-valid snapshots · measured delivery timing ↗</span></a><a class="measurement-preview" href={evidenceUrl("docs/evidence/rtl-continuity/README.md")}><img src={evidenceAsset("docs/evidence/rtl-continuity/continuity.png")} alt="Measured RTL internal-pattern transport durations and interval delivery estimates" loading="lazy"/><span>Measured USB delivery · oscillator calibration not implied ↗</span></a><a class="measurement-preview" href={evidenceUrl("docs/evidence/rtl-fm-survey/README.md")}><img src={evidenceAsset("docs/evidence/rtl-fm-survey/fm-structure.png")} alt="Actual measured FM candidate structure with unverified station and antenna" loading="lazy"/><span>Measured RF candidate · station and antenna unverified ↗</span></a></div></section>
<section class="section"><div class="section-head"><div><p class="eyebrow">ALL RENDERED RECORDS</p><h2>Source, design, hardware and host evidence.</h2></div><p>Record classes describe how the artifact was obtained, not whether a proposal is finished.</p></div><div class="record-list">{records.map(file=><article class="record"><p class="eyebrow">{classification(file.path)}</p><h2>{file.path.split("/").at(-2)?.replaceAll("-"," ")}</h2><p>{file.path}</p><a href={url(`evidence/${file.slug}/`)}>Inspect record and related files ↗</a></article>)}</div></section>
</Base>
