; Input-only rising-to-rising period sampling. Integer divider1.
; PUSH is outside the measured interval; skipped complete periods are possible.
.program forgix_clock_period
.wrap_target
    wait 0 pin 0
    wait 1 pin 0
    mov x, ~null
high:
    jmp pin high_again
    jmp low
high_again:
    jmp x-- high
low:
    jmp pin done
    jmp x-- low
done:
    mov isr, x
    push block
.wrap
