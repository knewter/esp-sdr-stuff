 extern void adctrig(uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t);
 static bool stock_capture(unsigned n,unsigned divider) {
+#if CONFIG_ESP32C5_REV_MIN_FULL < 100
+    /* ECO1 port: stock adctrig with the SRAM owner patched to bank 1. */
+    extern void adctrig_eco1_bank1(uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t);
+    adctrig_eco1_bank1(n-1,0,0,divider*2,0,0,0,0,0);
+#else
     adctrig(n-1,0,0,divider*2,0,0,0,0,0);
+#endif
     return true; /* Common sentinel check detects incomplete stock captures. */
 }
