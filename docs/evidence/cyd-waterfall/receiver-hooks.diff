+/* CYD display hooks: the same radio routines the host commands use. */
+static bool cyd_acquire(unsigned n, const uint32_t **words) {
+    unsigned elapsed;
+    bool ok = acquire_iq(n, 0, 0, &elapsed);
+    *words = samples;
+    return ok;
+}
+static bool cyd_tune(unsigned mhz) {
+    if (!rx_frequency_valid(mhz)) return false;
+    frequency_mhz = mhz; tune_rx(mhz);
+    prepare_rx(); apply_gain();
+    return true;
+}
+static unsigned cyd_frequency(void) { return frequency_mhz; }
+static bool cyd_agc(void) { return hardware_agc; }
+static const cyd_radio_t cyd_radio = {cyd_acquire, cyd_tune, cyd_frequency, cyd_agc};
+
 void app_main(void) {
     esp_log_level_set("*", ESP_LOG_NONE);
     esp_err_t e = nvs_flash_init();
